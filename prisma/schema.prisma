// processt — SG-SST para consultora (Colombia)
// Convención: tablas y campos en español sin tildes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: migraciones por la conexión directa (sin pooler). En local es la misma URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────── Consultora y usuarios ───────────────────────────

model Consultora {
  id               String                @id @default(cuid())
  nombre           String
  nit              String?
  licenciaSst      String?               @map("licencia_sst")
  licenciaFecha    DateTime?             @map("licencia_fecha")
  profesional      String? // nombre de la profesional que firma
  perfil           String? // tecnico | tecnologo | profesional | especialista
  cargo            String? // p. ej. "Asesora externa en SST"
  curso50h         Boolean               @default(false) @map("curso_50h")
  curso50hFecha    String?               @map("curso_50h_fecha")
  curso20hFecha    String?               @map("curso_20h_fecha")
  // Parámetros de criterio de la empresa (plazos editables de src/lib/plazos.ts): { clave: valor }.
  parametros       Json                  @default("{}")
  tipoDoc          String                @default("CC") @map("tipo_doc") // CC | CE | PA | PPT | PEP | TI
  cedula           String?
  telefono         String?
  correo           String?
  firmaUrl         String?               @map("firma_url")
  logoUrl          String?               @map("logo_url")
  creadoEn         DateTime              @default(now()) @map("creado_en")
  // La desactiva el super administrador: sus usuarios no pueden ingresar (los datos se conservan).
  activa           Boolean               @default(true)
  empresas         Empresa[]
  usuarios         Usuario[]
  plantillas       PlantillaConsultora[]
  peligros         PeligroCatalogo[]
  tareasTipo       TareaTipo[]
  cargosTipo       CargoTipo[]
  catalogo         CatalogoItem[]
  recordatorios    Recordatorio[]
  // Tope de gasto de IA en USD por mes calendario (null = sin tope). Lo fija el super administrador.
  iaTopeMensualUsd Float?                @map("ia_tope_mensual_usd")
  usosIa           UsoIa[]

  @@map("consultora")
}

model Usuario {
  id            String      @id @default(cuid())
  // null solo para el super administrador (administra consultoras; no pertenece a ninguna).
  consultoraId  String?     @map("consultora_id")
  consultora    Consultora? @relation(fields: [consultoraId], references: [id], onDelete: Cascade)
  // Para el futuro acceso de clientes (rol "cliente"): empresa a la que pertenece.
  empresaId     String?     @map("empresa_id")
  empresa       Empresa?    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email         String      @unique
  nombre        String
  passwordHash  String      @map("password_hash") // scrypt: sal:hash
  rol           String      @default("admin") // superadmin | admin | consultor | cliente
  activo        Boolean     @default(true)
  ultimoAcceso  DateTime?   @map("ultimo_acceso")
  // Sesiones iniciadas antes de esta fecha dejan de valer (al cambiar o restablecer la contraseña, o desactivar).
  sesionesDesde DateTime?   @map("sesiones_desde")
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@map("usuario")
}

// ─────────────────────────── Empresa cliente ───────────────────────────

model Empresa {
  id                       String      @id @default(cuid())
  consultoraId             String      @map("consultora_id")
  consultora               Consultora  @relation(fields: [consultoraId], references: [id])
  razonSocial              String      @map("razon_social")
  nit                      String
  digitoVerificacion       String?     @map("digito_verificacion")
  direccion                String?
  ciudad                   String?
  departamento             String?
  telefono                 String?
  correo                   String?
  representanteLegal       String?     @map("representante_legal")
  representanteTipoDoc     String      @default("CC") @map("representante_tipo_doc") // CC | CE | PA | PPT | PEP | TI
  representanteCedula      String?     @map("representante_cedula") // número del documento
  ciiu                     String?
  descripcionActividad     String?     @map("descripcion_actividad")
  claseRiesgo              Int         @default(1) @map("clase_riesgo") // 1..5 (Decreto 1607/2002)
  claseRiesgoJustificacion String?     @map("clase_riesgo_justificacion")
  arl                      String?
  epsPrincipal             String?     @map("eps_principal")
  nTrabajadoresPlanta      Int         @default(0) @map("n_trabajadores_planta")
  nContratistas            Int         @default(0) @map("n_contratistas")
  nAprendices              Int         @default(0) @map("n_aprendices")
  nEnMision                Int         @default(0) @map("n_en_mision")
  nVehiculos               Int         @default(0) @map("n_vehiculos")
  nConductores             Int         @default(0) @map("n_conductores") // personas que conducen al servicio de la empresa (PESV: desde 2)
  horario                  String?
  turnos                   String?
  nivelEstandares          Int         @default(7) @map("nivel_estandares") // 7 | 21 | 60
  esUpa                    Boolean     @default(false) @map("es_upa") // unidad de producción agropecuaria
  disparadores             Json        @default("{}") // { alturas: true, confinados: false, quimicos: true, ... }
  estadoActual             Json        @default("{}") @map("estado_actual") // respuestas del paso 6 del intake (por ítem)
  responsableSst           Json?       @map("responsable_sst") // { nombre, tipoDoc, cedula, cargo, perfil, licencia, licenciaFecha, curso50h, curso50hFecha }
  logoUrl                  String?     @map("logo_url")
  fechaInicioSgsst         DateTime?   @map("fecha_inicio_sgsst")
  sectorTipoId             String?     @map("sector_tipo_id")
  sectorTipo               SectorTipo? @relation(fields: [sectorTipoId], references: [id])
  // Datos que piden los documentos (emergencias, contactos, inventarios, presupuesto…). Ver src/lib/complementarios.ts
  datosComplementarios     Json        @default("{}") @map("datos_complementarios")
  resultadoReglas          Json?       @map("resultado_reglas") // salida del motor de reglas (nivel, items, documentos, normas, comites) con norma_ref
  creadoEn                 DateTime    @default(now()) @map("creado_en")
  actualizadoEn            DateTime    @updatedAt @map("actualizado_en")

  sedes            Sede[]
  zonas            Zona[]
  procesos         Proceso[]
  cargos           Cargo[]
  tareas           Tarea[]
  peligros         PeligroEvaluado[]
  matrizVersiones  MatrizVersion[]
  evaluaciones     Evaluacion[]
  documentos       Documento[]
  actividades      ActividadPlan[]
  evidencias       Evidencia[]
  eventos          Evento[]
  trabajadoresMes  TrabajadoresMes[]
  comites          Comite[]
  peligrosPropios  PeligroCatalogo[] @relation("BibliotecaPeligroCatalogo")
  tareasPropias    TareaTipo[]       @relation("BibliotecaTareaTipo")
  cargosPropios    CargoTipo[]       @relation("BibliotecaCargoTipo")
  catalogoPropio   CatalogoItem[]    @relation("BibliotecaCatalogoItem")
  usuarios         Usuario[]
  acciones         Accion[]
  recordatorios    Recordatorio[]
  trabajadores     Trabajador[]
  capacitaciones   Capacitacion[]
  inspecciones     Inspeccion[]
  visitas          Visita[]
  contratoHorasMes Float?            @map("contrato_horas_mes") // horas de asesoría pactadas al mes
  contratoValorMes Int?              @map("contrato_valor_mes") // valor mensual del contrato (pesos)
  auditorias       Auditoria[]
  diagnosticos     Diagnostico[]
  etapa            String            @default("activa") // diagnostico | activa

  @@map("empresa")
}

model Sede {
  id          String  @id @default(cuid())
  empresaId   String  @map("empresa_id")
  empresa     Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre      String
  direccion   String?
  ciudad      String?
  claseRiesgo Int?    @map("clase_riesgo")
  principal   Boolean @default(false)
  zonas       Zona[]
  cargos      Cargo[]

  @@map("sede")
}

model Zona {
  id         String            @id @default(cuid())
  empresaId  String            @map("empresa_id")
  empresa    Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sedeId     String?           @map("sede_id")
  sede       Sede?             @relation(fields: [sedeId], references: [id])
  zonaTipoId String?           @map("zona_tipo_id")
  zonaTipo   ZonaTipo?         @relation(fields: [zonaTipoId], references: [id])
  nombre     String
  tareas     Tarea[]
  cargos     Cargo[]
  peligros   PeligroEvaluado[]

  @@map("zona")
}

model Proceso {
  id            String       @id @default(cuid())
  empresaId     String       @map("empresa_id")
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  procesoTipoId String?      @map("proceso_tipo_id")
  procesoTipo   ProcesoTipo? @relation(fields: [procesoTipoId], references: [id])
  nombre        String
  descripcion   String?
  orden         Int          @default(0)
  tareas        Tarea[]

  @@map("proceso")
}

model Cargo {
  id                   String            @id @default(cuid())
  empresaId            String            @map("empresa_id")
  empresa              Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cargoTipoId          String?           @map("cargo_tipo_id")
  cargoTipo            CargoTipo?        @relation(fields: [cargoTipoId], references: [id])
  sedeId               String?           @map("sede_id")
  sede                 Sede?             @relation(fields: [sedeId], references: [id])
  zonaId               String?           @map("zona_id")
  zona                 Zona?             @relation(fields: [zonaId], references: [id])
  nombre               String
  area                 String?
  nPersonas            Int               @default(1) @map("n_personas")
  descripcionFunciones String?           @map("descripcion_funciones")
  // Periodicidad de las evaluaciones médicas periódicas, definida por la empresa con justificación técnica (Res. 1843/2025 art. 15).
  periodicidadMeses    Int?              @map("periodicidad_meses")
  periodicidadMotivo   String?           @map("periodicidad_motivo")
  tareas               CargoTarea[]
  peligros             PeligroEvaluado[]
  eventos              Evento[]
  trabajadores         Trabajador[]

  @@map("cargo")
}

model Tarea {
  id          String            @id @default(cuid())
  empresaId   String            @map("empresa_id")
  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tareaTipoId String?           @map("tarea_tipo_id")
  tareaTipo   TareaTipo?        @relation(fields: [tareaTipoId], references: [id])
  procesoId   String?           @map("proceso_id")
  proceso     Proceso?          @relation(fields: [procesoId], references: [id])
  zonaId      String?           @map("zona_id")
  zona        Zona?             @relation(fields: [zonaId], references: [id])
  actividad   String? // actividad (GTC 45) a la que pertenece la tarea
  nombre      String
  rutinaria   Boolean           @default(true)
  altoRiesgo  String?           @map("alto_riesgo") // alturas | confinado | electrico | izaje | caliente | null
  estado      String            @default("aprobado") // sugerido | aprobado
  fuente      String            @default("manual") // biblioteca | ia | manual
  cargos      CargoTarea[]
  peligros    PeligroEvaluado[]

  @@map("tarea")
}

model CargoTarea {
  cargoId String @map("cargo_id")
  tareaId String @map("tarea_id")
  cargo   Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  tarea   Tarea  @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@id([cargoId, tareaId])
  @@map("cargo_tarea")
}

// ─────────────────────────── Biblioteca (conocimiento compartido) ───────────────────────────

model SectorTipo {
  id          String           @id @default(cuid())
  nombre      String
  ciius       String[]         @default([]) // divisiones o códigos CIIU asociados
  descripcion String?
  validado    Boolean          @default(false)
  procesos    ProcesoTipo[]
  cargos      CargoTipo[]
  zonas       SectorZonaTipo[]
  empresas    Empresa[]

  @@map("sector_tipo")
}

model ProcesoTipo {
  id           String             @id @default(cuid())
  sectorTipoId String?            @map("sector_tipo_id")
  sectorTipo   SectorTipo?        @relation(fields: [sectorTipoId], references: [id])
  nombre       String
  descripcion  String?
  validado     Boolean            @default(false)
  tareas       TareaTipo[]
  tareasTipo   ProcesoTipoTarea[]
  procesos     Proceso[]

  @@map("proceso_tipo")
}

model ProcesoTipoTarea {
  procesoTipoId String      @map("proceso_tipo_id")
  tareaTipoId   String      @map("tarea_tipo_id")
  procesoTipo   ProcesoTipo @relation(fields: [procesoTipoId], references: [id], onDelete: Cascade)
  tareaTipo     TareaTipo   @relation(fields: [tareaTipoId], references: [id], onDelete: Cascade)

  @@id([procesoTipoId, tareaTipoId])
  @@map("proceso_tipo_tarea")
}

model ZonaTipo {
  id          String            @id @default(cuid())
  nombre      String            @unique
  descripcion String?
  validado    Boolean           @default(false)
  peligros    ZonaTipoPeligro[]
  sectores    SectorZonaTipo[]
  zonas       Zona[]

  @@map("zona_tipo")
}

model SectorZonaTipo {
  sectorTipoId String     @map("sector_tipo_id")
  zonaTipoId   String     @map("zona_tipo_id")
  sectorTipo   SectorTipo @relation(fields: [sectorTipoId], references: [id], onDelete: Cascade)
  zonaTipo     ZonaTipo   @relation(fields: [zonaTipoId], references: [id], onDelete: Cascade)

  @@id([sectorTipoId, zonaTipoId])
  @@map("sector_zona_tipo")
}

model CargoTipo {
  id           String             @id @default(cuid())
  sectorTipoId String?            @map("sector_tipo_id")
  sectorTipo   SectorTipo?        @relation(fields: [sectorTipoId], references: [id])
  nombre       String
  descripcion  String?
  validado     Boolean            @default(false)
  tareas       CargoTipoTarea[]
  peligros     CargoTipoPeligro[]
  cargos       Cargo[]

  // Alcance: null = biblioteca general; con valor = solo para esa empresa.
  empresaId    String?     @map("empresa_id")
  empresa      Empresa?    @relation("BibliotecaCargoTipo", fields: [empresaId], references: [id], onDelete: Cascade)
  // Biblioteca de tres niveles: base PROCESST (consultoraId y empresaId en null), propia de la consultora, o de una empresa.
  consultoraId String?     @map("consultora_id")
  consultora   Consultora? @relation(fields: [consultoraId], references: [id], onDelete: Cascade)

  @@map("cargo_tipo")
}

model TareaTipo {
  id              String             @id @default(cuid())
  procesoTipoId   String?            @map("proceso_tipo_id")
  procesoTipo     ProcesoTipo?       @relation(fields: [procesoTipoId], references: [id])
  nombre          String
  actividad       String?
  rutinaria       Boolean            @default(true)
  altoRiesgo      String?            @map("alto_riesgo")
  zonasPreferidas String[]           @default([]) @map("zonas_preferidas") // nombres de zona tipo, en orden de preferencia
  validado        Boolean            @default(false)
  peligros        TareaTipoPeligro[]
  cargos          CargoTipoTarea[]
  procesosTipo    ProcesoTipoTarea[]
  tareas          Tarea[]

  // Alcance: null = biblioteca general; con valor = solo para esa empresa.
  empresaId    String?     @map("empresa_id")
  empresa      Empresa?    @relation("BibliotecaTareaTipo", fields: [empresaId], references: [id], onDelete: Cascade)
  // Biblioteca de tres niveles: base PROCESST (consultoraId y empresaId en null), propia de la consultora, o de una empresa.
  consultoraId String?     @map("consultora_id")
  consultora   Consultora? @relation(fields: [consultoraId], references: [id], onDelete: Cascade)

  @@map("tarea_tipo")
}

model CargoTipoTarea {
  cargoTipoId String    @map("cargo_tipo_id")
  tareaTipoId String    @map("tarea_tipo_id")
  cargoTipo   CargoTipo @relation(fields: [cargoTipoId], references: [id], onDelete: Cascade)
  tareaTipo   TareaTipo @relation(fields: [tareaTipoId], references: [id], onDelete: Cascade)

  @@id([cargoTipoId, tareaTipoId])
  @@map("cargo_tipo_tarea")
}

// Catálogo de peligros según clasificación GTC 45
model PeligroCatalogo {
  id                       String             @id @default(cuid())
  clasificacion            String // Biologico | Fisico | Quimico | Psicosocial | Biomecanico | Condiciones de seguridad | Fenomenos naturales
  subclasificacion         String? // p. ej. "Ruido", "Iluminación", "Locativo", "Mecánico", "Eléctrico", "Postura", "Esfuerzo"
  claveSemilla             String?            @map("clave_semilla") // clave del peligro en la semilla; permite renombrar sin duplicar
  descripcion              String
  efectosPosibles          String             @map("efectos_posibles")
  ndDefault                Int                @default(2) @map("nd_default") // 0,2,6,10
  neDefault                Int                @default(2) @map("ne_default") // 1..4
  ncDefault                Int                @default(10) @map("nc_default") // 10,25,60,100
  controlesFuente          String?            @map("controles_fuente")
  controlesMedio           String?            @map("controles_medio")
  controlesIndividuo       String?            @map("controles_individuo")
  medidaEliminacion        String?            @map("medida_eliminacion")
  medidaSustitucion        String?            @map("medida_sustitucion")
  medidaIngenieria         String?            @map("medida_ingenieria")
  medidaAdministrativa     String?            @map("medida_administrativa")
  medidaEpp                String?            @map("medida_epp")
  eppSugerido              String[]           @default([]) @map("epp_sugerido")
  examenesSugeridos        String[]           @default([]) @map("examenes_sugeridos")
  capacitacionesSugeridas  String[]           @default([]) @map("capacitaciones_sugeridas")
  normas                   String[]           @default([]) // codigos de Norma
  pveAsociado              String?            @map("pve_asociado") // osteomuscular | auditivo | visual | quimico | psicosocial | respiratorio | biologico
  requisitoLegalEspecifico Boolean            @default(false) @map("requisito_legal_especifico")
  validado                 Boolean            @default(false)
  tareas                   TareaTipoPeligro[]
  zonas                    ZonaTipoPeligro[]
  cargos                   CargoTipoPeligro[]
  evaluados                PeligroEvaluado[]

  // Alcance: null = biblioteca general; con valor = solo para esa empresa.
  empresaId    String?     @map("empresa_id")
  empresa      Empresa?    @relation("BibliotecaPeligroCatalogo", fields: [empresaId], references: [id], onDelete: Cascade)
  // Biblioteca de tres niveles: base PROCESST (consultoraId y empresaId en null), propia de la consultora, o de una empresa.
  consultoraId String?     @map("consultora_id")
  consultora   Consultora? @relation(fields: [consultoraId], references: [id], onDelete: Cascade)
  eventos      Evento[]

  @@map("peligro_catalogo")
}

model TareaTipoPeligro {
  tareaTipoId String          @map("tarea_tipo_id")
  peligroId   String          @map("peligro_id")
  nd          Int?
  ne          Int?
  nc          Int?
  tareaTipo   TareaTipo       @relation(fields: [tareaTipoId], references: [id], onDelete: Cascade)
  peligro     PeligroCatalogo @relation(fields: [peligroId], references: [id], onDelete: Cascade)

  @@id([tareaTipoId, peligroId])
  @@map("tarea_tipo_peligro")
}

model ZonaTipoPeligro {
  zonaTipoId String          @map("zona_tipo_id")
  peligroId  String          @map("peligro_id")
  nd         Int?
  ne         Int?
  nc         Int?
  zonaTipo   ZonaTipo        @relation(fields: [zonaTipoId], references: [id], onDelete: Cascade)
  peligro    PeligroCatalogo @relation(fields: [peligroId], references: [id], onDelete: Cascade)

  @@id([zonaTipoId, peligroId])
  @@map("zona_tipo_peligro")
}

model CargoTipoPeligro {
  cargoTipoId String          @map("cargo_tipo_id")
  peligroId   String          @map("peligro_id")
  nd          Int?
  ne          Int?
  nc          Int?
  cargoTipo   CargoTipo       @relation(fields: [cargoTipoId], references: [id], onDelete: Cascade)
  peligro     PeligroCatalogo @relation(fields: [peligroId], references: [id], onDelete: Cascade)

  @@id([cargoTipoId, peligroId])
  @@map("cargo_tipo_peligro")
}

// ─────────────────────────── Matriz de peligros (instancia por empresa) ───────────────────────────

model MatrizVersion {
  id         String            @id @default(cuid())
  empresaId  String            @map("empresa_id")
  empresa    Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero     Int
  motivo     String // inicial | anual | gestion_cambio
  fecha      DateTime          @default(now())
  snapshot   Json? // copia de la matriz al cerrar: { filas: [...] } (versiones antiguas: arreglo de peligros)
  cerradoPor String?           @map("cerrado_por")
  resumen    Json? // { total, prioritarios, porNivel }
  peligros   PeligroEvaluado[]

  @@map("matriz_version")
}

model PeligroEvaluado {
  id                   String           @id @default(cuid())
  empresaId            String           @map("empresa_id")
  empresa              Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  matrizVersionId      String?          @map("matriz_version_id")
  matrizVersion        MatrizVersion?   @relation(fields: [matrizVersionId], references: [id])
  origen               String // tarea | zona | cargo
  tareaId              String?          @map("tarea_id")
  tarea                Tarea?           @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  zonaId               String?          @map("zona_id")
  zona                 Zona?            @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  cargoId              String?          @map("cargo_id")
  cargo                Cargo?           @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  peligroId            String?          @map("peligro_id")
  peligro              PeligroCatalogo? @relation(fields: [peligroId], references: [id])
  clasificacion        String
  descripcion          String
  efectosPosibles      String?          @map("efectos_posibles")
  controlesFuente      String?          @map("controles_fuente")
  controlesMedio       String?          @map("controles_medio")
  controlesIndividuo   String?          @map("controles_individuo")
  nd                   Int              @default(2)
  ne                   Int              @default(2)
  nc                   Int              @default(10)
  peorConsecuencia     String?          @map("peor_consecuencia")
  requisitoLegal       Boolean          @default(false) @map("requisito_legal")
  medidaEliminacion    String?          @map("medida_eliminacion")
  medidaSustitucion    String?          @map("medida_sustitucion")
  medidaIngenieria     String?          @map("medida_ingenieria")
  medidaAdministrativa String?          @map("medida_administrativa")
  medidaEpp            String?          @map("medida_epp")
  // Implementación y verificación de las medidas (Res. 0312/2019 est. 4.2.1 y 4.2.2): responsable, fecha, estado, verificación y eficacia.
  seguimiento          Json             @default("{}")
  estado               String           @default("aprobado") // sugerido | aprobado
  fuente               String           @default("manual") // biblioteca | ia | manual
  creadoEn             DateTime         @default(now()) @map("creado_en")

  @@map("peligro_evaluado")
}

// ─────────────────────────── Normativo ───────────────────────────

model Estandar {
  id                String           @id @default(cuid())
  codigo            String           @unique // "1.1.1"
  ciclo             String // PLANEAR | HACER | VERIFICAR | ACTUAR
  grupo             String // "1. Recursos (10%)"
  subgrupo          String // "1.1 Recursos financieros..."
  descripcion       String
  puntaje           Float
  aplica7           Boolean          @default(false) @map("aplica_7")
  aplica21          Boolean          @default(false) @map("aplica_21")
  modoVerificacion  String?          @map("modo_verificacion") // qué evidencia pide el inspector (Res. 0312 art. 16)
  actividadSugerida String?          @map("actividad_sugerida") // actividad para el plan de mejoramiento
  orden             Int
  items             EvaluacionItem[]

  @@map("estandar")
}

model Norma {
  id                     String    @id @default(cuid())
  codigo                 String    @unique // "DEC-1072-2015"
  tipo                   String // Ley | Decreto | Resolucion | Circular | GuiaTecnica | Norma
  numero                 String
  anio                   Int
  entidad                String
  nombre                 String
  tema                   String
  resumen                String
  articulosClave         String?   @map("articulos_clave")
  urlOficial             String?   @map("url_oficial")
  condicionAplicabilidad Json      @default("{\"siempre\":true}") @map("condicion_aplicabilidad")
  vigenteDesde           DateTime? @map("vigente_desde")
  derogadaPor            String?   @map("derogada_por")
  vigente                Boolean   @default(true)
  evidenciaCumplimiento  String?   @map("evidencia_cumplimiento") // qué documento/registro demuestra cumplimiento

  @@map("norma")
}

model ReglaAplicabilidad {
  id        String  @id @default(cuid())
  codigo    String  @unique
  nombre    String
  condicion Json // { trabajadores: {min,max}, claseRiesgo: {in: []}, disparador: "alturas", esUpa: true }
  efecto    Json // { nivel, documentos: [], normas: [], comites: [], capacitaciones: [], mensaje }
  normaRef  String  @map("norma_ref")
  prioridad Int     @default(0)
  activa    Boolean @default(true)

  @@map("regla_aplicabilidad")
}

model CiiuClaseRiesgo {
  id          String @id @default(cuid())
  codigo      String @unique // "4711" o división "47"
  descripcion String
  claseRiesgo Int    @map("clase_riesgo")
  fuente      String @default("Decreto 1607/2002")

  @@map("ciiu_clase_riesgo")
}

// ─────────────────────────── Evaluación (inicial y autoevaluación anual) ───────────────────────────

model Evaluacion {
  id              String                 @id @default(cuid())
  empresaId       String                 @map("empresa_id")
  empresa         Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo            String // inicial | anual
  anio            Int
  fecha           DateTime               @default(now())
  nivel           Int
  puntajeBruto    Float?                 @map("puntaje_bruto")
  puntajeAjustado Float?                 @map("puntaje_ajustado")
  valoracion      String? // CRITICO | MODERADAMENTE_ACEPTABLE | ACEPTABLE
  cerrada         Boolean                @default(false)
  observaciones   String?
  items           EvaluacionItem[]
  planMejora      PlanMejoramientoItem[]

  @@map("evaluacion")
}

model EvaluacionItem {
  id            String     @id @default(cuid())
  evaluacionId  String     @map("evaluacion_id")
  evaluacion    Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  estandarId    String     @map("estandar_id")
  estandar      Estandar   @relation(fields: [estandarId], references: [id])
  estado        String     @default("PENDIENTE") // CUMPLE | NO_CUMPLE | NO_APLICA | PENDIENTE
  justificacion String?
  observacion   String?
  evidenciaIds  String[]   @default([]) @map("evidencia_ids")

  @@unique([evaluacionId, estandarId])
  @@map("evaluacion_item")
}

model PlanMejoramientoItem {
  id             String     @id @default(cuid())
  evaluacionId   String     @map("evaluacion_id")
  evaluacion     Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  estandarCodigo String     @map("estandar_codigo")
  actividad      String
  responsable    String?
  fechaLimite    DateTime?  @map("fecha_limite")
  recursos       String?
  soporte        String?
  estado         String     @default("PENDIENTE") // PENDIENTE | EN_CURSO | CUMPLIDA
  avance         String?

  @@map("plan_mejoramiento_item")
}

// ─────────────────────────── Plantillas y documentos ───────────────────────────

model Plantilla {
  id                String                @id @default(cuid())
  codigo            String                @unique // "POL-01"
  nombre            String
  tipo              String // POL | DOC | PRG | PRC | FOR | ACT | MTZ | PLN
  nivelMin          Int                   @default(7) @map("nivel_min") // 7 | 21 | 60
  condicion         Json? // condición adicional (disparador, trabajadores>=10, etc.)
  estandares        String[]              @default([])
  normas            String[]              @default([]) // codigos de Norma
  descripcion       String?
  contenidoMd       String                @map("contenido_md") // Markdown + Handlebars; secciones separadas por "## "
  version           Int                   @default(1)
  vigenteDesde      DateTime              @default(now()) @map("vigente_desde")
  carpeta           String? // carpeta destino en el ZIP (p. ej. "2. Gestion integral")
  documentos        Documento[]
  editadaPorUsuario Boolean               @default(false) @map("editada_por_usuario") // obsoleto: las ediciones van a PlantillaConsultora
  ajustes           PlantillaConsultora[]

  @@map("plantilla")
}

/// Versión propia de una plantilla para una consultora. La base (Plantilla) la mantiene PROCESST y se actualiza en cada
/// despliegue; si la consultora la ajusta, usa su versión hasta que la restaure.
model PlantillaConsultora {
  id           String     @id @default(cuid())
  consultoraId String     @map("consultora_id")
  consultora   Consultora @relation(fields: [consultoraId], references: [id], onDelete: Cascade)
  plantillaId  String     @map("plantilla_id")
  plantilla    Plantilla  @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  contenidoMd  String     @map("contenido_md")
  version      Int        @default(1)
  vigenteDesde DateTime   @default(now()) @map("vigente_desde")
  // Versión de la base sobre la que se hizo el ajuste (para avisar cuando la base cambió después).
  baseVersion  Int        @map("base_version")

  @@unique([consultoraId, plantillaId])
  @@map("plantilla_consultora")
}

model Documento {
  id             String             @id @default(cuid())
  empresaId      String             @map("empresa_id")
  empresa        Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plantillaId    String             @map("plantilla_id")
  plantilla      Plantilla          @relation(fields: [plantillaId], references: [id])
  codigo         String // POL-01
  nombre         String
  version        Int                @default(1)
  estado         String             @default("BORRADOR") // BORRADOR | APROBADO | FIRMADO
  fechaEmision   DateTime           @default(now()) @map("fecha_emision")
  generadoEn     DateTime           @default(now()) @map("generado_en")
  archivoPdfUrl  String?            @map("archivo_pdf_url")
  archivoDocxUrl String?            @map("archivo_docx_url")
  secciones      DocumentoSeccion[]
  archivos       Evidencia[]

  @@unique([empresaId, codigo])
  @@map("documento")
}

model DocumentoSeccion {
  id                String    @id @default(cuid())
  documentoId       String    @map("documento_id")
  documento         Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  orden             Int
  titulo            String
  contenidoGenerado String    @map("contenido_generado")
  contenidoEditado  String?   @map("contenido_editado")
  requiereRevision  Boolean   @default(false) @map("requiere_revision") // generado cambió y existe edición manual
  actualizadoEn     DateTime  @updatedAt @map("actualizado_en")

  @@map("documento_seccion")
}

// ─────────────────────────── Plan anual, evidencias, eventos ───────────────────────────

model ActividadPlan {
  id             String         @id @default(cuid())
  empresaId      String         @map("empresa_id")
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  anio           Int
  mes            Int // 1..12
  nombre         String
  descripcion    String?
  estandarCodigo String?        @map("estandar_codigo")
  normaRef       String?        @map("norma_ref")
  responsable    String?
  recursos       String?
  origen         String         @default("nivel") // nivel | matriz | mejoramiento | comite | periodica | manual
  estado         String         @default("PENDIENTE") // PENDIENTE | EJECUTADA | VENCIDA | CANCELADA
  fechaEjecucion DateTime?      @map("fecha_ejecucion")
  evidencias     Evidencia[]
  acciones       Accion[]
  capacitaciones Capacitacion[]

  @@map("actividad_plan")
}

// Archivos subidos: documentos firmados, evidencias de ejecución y actas.
// Nunca se borran definitivamente (Decreto 1072/2015 art. 2.2.4.6.13): "eliminar" los marca inactivos.
model Evidencia {
  id               String         @id @default(cuid())
  empresaId        String         @map("empresa_id")
  empresa          Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo             String         @default("EVIDENCIA") // DOCUMENTO_FIRMADO | EVIDENCIA | ACTA
  actividadId      String?        @map("actividad_id")
  actividad        ActividadPlan? @relation(fields: [actividadId], references: [id], onDelete: SetNull)
  documentoId      String?        @map("documento_id")
  documento        Documento?     @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  documentoVersion Int?           @map("documento_version") // versión del documento que se firmó
  comiteId         String?        @map("comite_id")
  comite           Comite?        @relation(fields: [comiteId], references: [id], onDelete: SetNull)
  eventoId         String?        @map("evento_id")
  evento           Evento?        @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  inspeccionId     String?        @map("inspeccion_id")
  inspeccion       Inspeccion?    @relation(fields: [inspeccionId], references: [id], onDelete: SetNull)
  auditoriaId      String?        @map("auditoria_id")
  auditoria        Auditoria?     @relation(fields: [auditoriaId], references: [id], onDelete: SetNull)
  diagnosticoId    String?        @map("diagnostico_id")
  diagnostico      Diagnostico?   @relation(fields: [diagnosticoId], references: [id], onDelete: SetNull)
  estandarCodigo   String?        @map("estandar_codigo")
  descripcion      String
  archivoUrl       String?        @map("archivo_url") // ruta relativa en uploads/
  nombreArchivo    String?        @map("nombre_archivo")
  mime             String?
  tamano           Int?
  fecha            DateTime       @default(now()) // fecha del hecho (firma, capacitación, reunión)
  subidoEn         DateTime       @default(now()) @map("subido_en")
  subidoPor        String?        @map("subido_por") // nombre del usuario
  activo           Boolean        @default(true)
  motivoBaja       String?        @map("motivo_baja")

  @@index([empresaId, estandarCodigo])
  @@map("evidencia")
}

// Accidente de trabajo, incidente, enfermedad laboral o ausentismo.
// Registro, reporte (Decreto Ley 1295/1994), investigación (Res. 1401/2007; Decreto 1072/2015 art. 2.2.4.6.32)
// e indicadores (Res. 0312/2019 art. 30). Sin diagnósticos médicos (Ley 1581/2012).
model Evento {
  id                String           @id @default(cuid())
  empresaId         String           @map("empresa_id")
  empresa           Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo              String // AT | INCIDENTE | EL | AUSENTISMO
  fecha             DateTime
  hora              String?
  lugar             String?
  descripcion       String?
  trabajadorNombre  String?          @map("trabajador_nombre")
  trabajadorTipoDoc String?          @map("trabajador_tipo_doc")
  trabajadorCedula  String?          @map("trabajador_cedula")
  vinculacion       String? // planta | contratista | aprendiz | mision | visitante
  antiguedad        String?
  cargo             String?
  cargoId           String?          @map("cargo_id")
  cargoRef          Cargo?           @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  tarea             String?
  mecanismo         String? // forma del accidente: caída, golpe, atrapamiento…
  agente            String?
  lesion            String? // tipo de lesión (sin diagnóstico)
  parteCuerpo       String?          @map("parte_cuerpo")
  gravedad          String           @default("leve") // leve | grave | mortal (grave: Res. 1401/2007 art. 3)
  testigos          String?
  // Variables del FURAT (Res. 156/2005) que el informe de investigación debe contener (Res. 1401/2007 art. 9)
  sitioExacto       String?          @map("sitio_exacto") // sitio exacto donde ocurrió el evento (art. 9)
  tipoAccidente     String?          @map("tipo_accidente") // propio_trabajo | transito | violencia | deportivo_recreativo (FURAT)
  jornadaHabitual   Boolean?         @map("jornada_habitual") // ¿estaba en su jornada o labor habitual? (FURAT)
  turno             String? // jornada o turno de trabajo (FURAT)
  // Datos del FURAT que el informe de investigación retoma (Res. 1401/2007 art. 9; Res. 156/2005 anexo). Se precargan del trabajador.
  sexo              String?
  fechaNacimiento   DateTime?        @map("fecha_nacimiento")
  eps               String?
  afp               String?
  sede              String? // sede o centro de trabajo
  expuestos         String? // trabajadores potencialmente expuestos y acciones para ellos (Res. 0312/2019 est. 3.2.2)
  tiempoEmpresa     String?          @map("tiempo_empresa") // antigüedad en la empresa (FURAT); `antiguedad` es en el cargo
  tiempoLaborado    String?          @map("tiempo_laborado") // tiempo laborado previo al evento (FURAT)
  versionTrabajador String?          @map("version_trabajador") // relato del trabajador (Res. 1401/2007 art. 10)
  versionTestigos   String?          @map("version_testigos") // versión de los testigos (art. 10)
  diasIncapacidad   Int              @default(0) @map("dias_incapacidad")
  diasCargados      Int              @default(0) @map("dias_cargados")
  mortal            Boolean          @default(false)
  casoNuevo         Boolean          @default(true) @map("caso_nuevo") // para EL: nuevo vs antiguo
  origenAusencia    String?          @map("origen_ausencia") // laboral | comun
  // Reporte
  reportadoArl      Boolean          @default(false) @map("reportado_arl")
  fechaReporte      DateTime?        @map("fecha_reporte")
  furatNumero       String?          @map("furat_numero")
  reporteMinisterio DateTime?        @map("reporte_ministerio")
  // Investigación
  investigado       Boolean          @default(false)
  invEstado         String           @default("pendiente") @map("inv_estado") // pendiente | en_curso | cerrada | no_aplica
  invInicio         DateTime?        @map("inv_inicio")
  invCierre         DateTime?        @map("inv_cierre")
  invRemitidaArl    DateTime?        @map("inv_remitida_arl")
  invLugar          String?          @map("inv_lugar") // lugar y dirección donde se hizo la investigación (Res. 1401/2007 art. 13)
  invFechas         String?          @map("inv_fechas") // fechas y horas de las sesiones de investigación (art. 13)
  equipo            Json             @default("[]") // [{ nombre, cargo, documento, rol }] (art. 7 y 13)
  analisis          Json             @default("{}") // { porques[], actos[], condiciones[], personales[], trabajo[], conclusion }
  lecciones         String?
  peligroId         String?          @map("peligro_id")
  peligro           PeligroCatalogo? @relation(fields: [peligroId], references: [id], onDelete: SetNull)
  creadoEn          DateTime         @default(now()) @map("creado_en")
  archivos          Evidencia[]
  acciones          Accion[]

  @@index([empresaId, fecha])
  @@map("evento")
}

// Acciones preventivas, correctivas y de mejora (Decreto 1072/2015 arts. 2.2.4.6.33 y 2.2.4.6.34). Alimenta FOR-06.
model Accion {
  id           String         @id @default(cuid())
  empresaId    String         @map("empresa_id")
  empresa      Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  eventoId     String?        @map("evento_id")
  evento       Evento?        @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  inspeccionId String?        @map("inspeccion_id")
  inspeccion   Inspeccion?    @relation(fields: [inspeccionId], references: [id], onDelete: SetNull)
  origen       String         @default("investigacion") // investigacion | inspeccion | auditoria | revision | arl | autoridad | trabajador
  fecha        DateTime       @default(now())
  hallazgo     String
  causa        String?
  tipo         String         @default("correctiva") // correctiva | preventiva | mejora
  jerarquia    String? // eliminacion | sustitucion | ingenieria | administrativo | epp
  dirigidaA    String?        @map("dirigida_a") // fuente | medio | trabajador (Res. 1401/2007 art. 12)
  descripcion  String
  responsable  String?
  fechaLimite  DateTime?      @map("fecha_limite")
  estado       String         @default("abierta") // abierta | cerrada
  fechaCierre  DateTime?      @map("fecha_cierre")
  eficacia     String?
  actividadId  String?        @map("actividad_id")
  actividad    ActividadPlan? @relation(fields: [actividadId], references: [id], onDelete: SetNull)
  auditoriaId  String?        @map("auditoria_id")
  auditoria    Auditoria?     @relation(fields: [auditoriaId], references: [id], onDelete: SetNull)

  @@map("accion")
}

// Fechas propias que la consultora agrega al planeador (visitas, entregas, vencimientos externos…).
model Recordatorio {
  id           String      @id @default(cuid())
  empresaId    String?     @map("empresa_id") // null = de la consultora, no de una empresa
  empresa      Empresa?    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  consultoraId String?     @map("consultora_id")
  consultora   Consultora? @relation(fields: [consultoraId], references: [id], onDelete: Cascade)
  fecha        DateTime
  titulo       String
  notas        String?
  hecho        Boolean     @default(false)
  hechoEn      DateTime?   @map("hecho_en")
  creadoEn     DateTime    @default(now()) @map("creado_en")

  @@index([fecha])
  @@map("recordatorio")
}

// ─────────────────────────── Trabajadores ───────────────────────────
// Datos personales mínimos (Ley 1581/2012). De salud solo el concepto de aptitud, nunca diagnósticos.
model Trabajador {
  id                String                   @id @default(cuid())
  empresaId         String                   @map("empresa_id")
  empresa           Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombres           String
  tipoDoc           String                   @default("CC") @map("tipo_doc")
  documento         String?
  cargoId           String?                  @map("cargo_id")
  cargo             Cargo?                   @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  vinculacion       String                   @default("planta") // planta | contratista | aprendiz | mision
  fechaIngreso      DateTime?                @map("fecha_ingreso")
  fechaRetiro       DateTime?                @map("fecha_retiro")
  activo            Boolean                  @default(true)
  sexo              String? // F | M | otro
  // Condiciones normativas que dispara esta persona (PESV, teletrabajo, jornada nocturna, alto riesgo pensional)
  conduce           Boolean                  @default(false) // conduce vehículos al servicio de la empresa (PESV: desde 2 conductores)
  modalidad         String                   @default("presencial") // presencial | teletrabajo | remoto | trabajo_en_casa
  turnoNocturno     Boolean                  @default(false) @map("turno_nocturno") // trabaja entre 7:00 p. m. y 6:00 a. m.
  altoRiesgoPension Boolean                  @default(false) @map("alto_riesgo_pension") // actividad del art. 2 del Decreto 2090/2003
  manipulaAlimentos Boolean                  @default(false) @map("manipula_alimentos") // Res. 2674/2013: certificado médico anual y 10 h de capacitación
  fechaNacimiento   DateTime?                @map("fecha_nacimiento")
  escolaridad       String?
  telefono          String?
  correo            String?
  eps               String?
  afp               String?
  creadoEn          DateTime                 @default(now()) @map("creado_en")
  examenes          ExamenMedico[]
  entregasEpp       EntregaEpp[]
  asistencias       AsistenciaCapacitacion[]

  @@index([empresaId])
  @@map("trabajador")
}

// Evaluación médica ocupacional (Res. 1843/2025): solo concepto y recomendaciones, nunca diagnóstico.
model ExamenMedico {
  id                    String     @id @default(cuid())
  trabajadorId          String     @map("trabajador_id")
  trabajador            Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  tipo                  String // Res. 1843/2025 art. 8: ingreso (pre-ingreso) | periodico | cambio_ocupacion | retiro (egreso) | post_incapacidad | retorno_laboral | seguimiento
  fecha                 DateTime
  ips                   String?
  // Res. 1843/2025 art. 19 par.: no se usa "no apto" salvo en los regímenes especiales del art. 2 (campo regimen).
  concepto              String // apto | apto_recomendaciones | apto_restricciones | aplazado | no_apto (solo con regimen)
  regimen               String? // alturas | conduccion | alimentos | armas | electrico | confinados
  restricciones         String? // recomendaciones y restricciones (sin diagnósticos)
  restriccionHasta      DateTime?  @map("restriccion_hasta") // vigencia de la restricción; vacío = permanente o sin restricción
  restriccionPermanente Boolean    @default(false) @map("restriccion_permanente")
  adaptacionFecha       DateTime?  @map("adaptacion_fecha") // fecha en que se adaptó el puesto (Res. 1843/2025 art. 19 par.)
  comunicadoTrabajador  DateTime?  @map("comunicado_trabajador")
  proximo               DateTime?
  creadoEn              DateTime   @default(now()) @map("creado_en")

  @@map("examen_medico")
}

model EntregaEpp {
  id                String     @id @default(cuid())
  trabajadorId      String     @map("trabajador_id")
  trabajador        Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  fecha             DateTime
  elemento          String
  cantidad          Int        @default(1)
  tipo              String     @default("dotacion") // dotacion | reposicion
  capacitado        Boolean    @default(true)
  proximaReposicion DateTime?  @map("proxima_reposicion")
  creadoEn          DateTime   @default(now()) @map("creado_en")

  @@map("entrega_epp")
}

// Sesión de capacitación ejecutada (Decreto 1072/2015 art. 2.2.4.6.11) con su asistencia.
model Capacitacion {
  id          String                   @id @default(cuid())
  empresaId   String                   @map("empresa_id")
  empresa     Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fecha       DateTime
  tema        String
  horas       Float                    @default(1)
  facilitador String?
  modalidad   String                   @default("presencial") // presencial | virtual
  actividadId String?                  @map("actividad_id")
  actividad   ActividadPlan?           @relation(fields: [actividadId], references: [id], onDelete: SetNull)
  creadoEn    DateTime                 @default(now()) @map("creado_en")
  asistentes  AsistenciaCapacitacion[]

  @@map("capacitacion")
}

model AsistenciaCapacitacion {
  id             String       @id @default(cuid())
  capacitacionId String       @map("capacitacion_id")
  capacitacion   Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  trabajadorId   String       @map("trabajador_id")
  trabajador     Trabajador   @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  aprobo         Boolean?

  @@unique([capacitacionId, trabajadorId])
  @@map("asistencia_capacitacion")
}

// Inspección de seguridad con lista de chequeo (Res. 0312/2019 estándar 4.2.4). Los hallazgos generan acciones (FOR-06).
model Inspeccion {
  id            String      @id @default(cuid())
  empresaId     String      @map("empresa_id")
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lista         String // nombre de la lista de chequeo usada
  fecha         DateTime
  lugar         String?
  responsable   String?
  participantes String? // por ejemplo, integrante del COPASST o Vigía
  items         Json        @default("[]") // [{ pregunta, resultado: cumple | no_cumple | na, observacion }]
  observaciones String?
  creadoEn      DateTime    @default(now()) @map("creado_en")
  acciones      Accion[]
  archivos      Evidencia[]

  @@index([empresaId, fecha])
  @@map("inspeccion")
}

// Bitácora de visitas y reuniones de la consultora con el cliente (horas dedicadas).
model Visita {
  id          String   @id @default(cuid())
  empresaId   String   @map("empresa_id")
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fecha       DateTime
  horas       Float    @default(1)
  modalidad   String   @default("presencial") // presencial | virtual
  atendio     String? // persona del cliente que atendió
  actividades String
  compromisos String?
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@index([empresaId, fecha])
  @@map("visita")
}

// Auditoría interna anual del SG-SST (Decreto 1072/2015 arts. 2.2.4.6.29 y 2.2.4.6.30; Res. 0312/2019 estándares 6.1.2 y 6.1.4).
model Auditoria {
  id              String      @id @default(cuid())
  empresaId       String      @map("empresa_id")
  empresa         Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  anio            Int
  fechaInicio     DateTime    @map("fecha_inicio")
  fechaCierre     DateTime?   @map("fecha_cierre")
  auditor         String
  auditorPerfil   String?     @map("auditor_perfil") // formación e independencia del auditor
  independiente   Boolean     @default(false) // declaración: no audita su propio trabajo (Decreto 1072/2015 art. 2.2.4.6.29)
  comunicadoA     String?     @map("comunicado_a") // a quién se comunicaron los resultados (art. 2.2.4.6.29)
  comunicadoFecha DateTime?   @map("comunicado_fecha")
  participantes   String? // COPASST o Vigía que participó en la planificación
  alcance         String?
  metodologia     String?
  items           Json        @default("[]") // [{ n, aspecto, criterio, estandares, resultado, evidencia, hallazgo }]
  conclusiones    String?
  estado          String      @default("en_curso") // en_curso | cerrada
  creadoEn        DateTime    @default(now()) @map("creado_en")
  acciones        Accion[]
  archivos        Evidencia[]

  @@index([empresaId, anio])
  @@map("auditoria")
}

// Diagnóstico inicial (opcional, antes de montar el SG-SST): estado actual frente a los estándares mínimos
// (Res. 0312/2019; Decreto 1072/2015 art. 2.2.4.6.16). Queda como línea base para medir el avance.
model Diagnostico {
  id           String      @id @default(cuid())
  empresaId    String      @map("empresa_id")
  empresa      Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fecha        DateTime    @default(now())
  nivel        Int
  items        Json        @default("[]") // [{ codigo, ciclo, grupo, descripcion, puntaje, modo, actividad, estado, observacion }]
  puntaje      Float?
  valoracion   String?
  porCiclo     Json?       @map("por_ciclo") // { P: { obtenido, maximo, pct }, ... }
  conclusiones String?
  estado       String      @default("borrador") // borrador | cerrado
  cerradoEn    DateTime?   @map("cerrado_en")
  evaluacionId String?     @map("evaluacion_id") // evaluación inicial creada al iniciar el SG-SST
  creadoEn     DateTime    @default(now()) @map("creado_en")
  archivos     Evidencia[]

  @@map("diagnostico")
}

model TrabajadoresMes {
  id              String  @id @default(cuid())
  empresaId       String  @map("empresa_id")
  empresa         Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  anio            Int
  mes             Int
  nTrabajadores   Int     @map("n_trabajadores")
  diasProgramados Int?    @map("dias_programados")

  @@unique([empresaId, anio, mes])
  @@map("trabajadores_mes")
}

// ─────────────────────────── Comités ───────────────────────────

model Comite {
  id            String          @id @default(cuid())
  empresaId     String          @map("empresa_id")
  empresa       Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo          String // COPASST | VIGIA | CCL | BRIGADA
  sede          String? // centro de trabajo, cuando la empresa tiene un CCL por sede (Res. 3461/2025 art. 3)
  periodoInicio DateTime?       @map("periodo_inicio")
  periodoFin    DateTime?       @map("periodo_fin")
  normaRef      String?         @map("norma_ref")
  // Datos de la elección o conformación: convocatoria, votación, resultados.
  datos         Json            @default("{}")
  miembros      ComiteMiembro[]
  actas         Acta[]
  archivos      Evidencia[]

  @@map("comite")
}

model ComiteMiembro {
  id         String  @id @default(cuid())
  comiteId   String  @map("comite_id")
  comite     Comite  @relation(fields: [comiteId], references: [id], onDelete: Cascade)
  nombre     String
  tipoDoc    String  @default("CC") @map("tipo_doc") // CC | CE | PA | PPT | PEP | TI
  cedula     String?
  cargo      String?
  rol        String // presidente | secretario | principal_empleador | principal_trabajadores | suplente_empleador | suplente_trabajadores | brigadista | jefe_brigada
  calidad    String? // principal | suplente (separado del cargo en el comité: presidente | secretario)
  representa String? // empleador | trabajadores

  @@map("comite_miembro")
}

model Acta {
  id          String   @id @default(cuid())
  comiteId    String   @map("comite_id")
  comite      Comite   @relation(fields: [comiteId], references: [id], onDelete: Cascade)
  numero      Int
  fecha       DateTime
  tipo        String   @default("ordinaria") // conformacion | ordinaria | extraordinaria
  contenidoMd String   @map("contenido_md")
  compromisos Json     @default("[]")

  @@map("acta")
}

// Catálogos parametrizables de la biblioteca: exámenes médicos, EPP y capacitaciones.
model CatalogoItem {
  id           String      @id @default(cuid())
  tipo         String // EXAMEN | EPP | CAPACITACION
  nombre       String
  descripcion  String?
  detalle      Json        @default("{}") // EXAMEN: { momento: ["ingreso","periodico","retiro"], periodicidad, enfasis } · EPP: { normaTecnica, reposicion, parteCuerpo } · CAPACITACION: { intensidadHoras, dirigidoA, periodicidad, certificacion }
  normas       String[]    @default([])
  validado     Boolean     @default(false)
  creadoEn     DateTime    @default(now()) @map("creado_en")
  // Alcance: null = biblioteca general; con valor = solo para esa empresa.
  empresaId    String?     @map("empresa_id")
  empresa      Empresa?    @relation("BibliotecaCatalogoItem", fields: [empresaId], references: [id], onDelete: Cascade)
  // Biblioteca de tres niveles: base PROCESST (consultoraId y empresaId en null), propia de la consultora, o de una empresa.
  consultoraId String?     @map("consultora_id")
  consultora   Consultora? @relation(fields: [consultoraId], references: [id], onDelete: Cascade)

  @@unique([tipo, nombre, empresaId, consultoraId])
  @@map("catalogo_item")
}

/// Cada llamada a la IA: quién la usó, para qué, con qué modelo y cuánto costó (control de gasto por consultora).
model UsoIa {
  id            String     @id @default(cuid())
  consultoraId  String     @map("consultora_id")
  consultora    Consultora @relation(fields: [consultoraId], references: [id], onDelete: Cascade)
  usuarioId     String?    @map("usuario_id")
  tarea         String // matriz | accidente | accion | observaciones | biblioteca
  modelo        String
  tokensEntrada Int        @default(0) @map("tokens_entrada")
  tokensSalida  Int        @default(0) @map("tokens_salida")
  costoUsd      Float      @default(0) @map("costo_usd")
  ok            Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")

  @@index([consultoraId, creadoEn])
  @@map("uso_ia")
}

/// Base de conocimiento del asistente: fichas citables (requisitos, estándares, normas, manual, plazos, decisiones,
/// plantillas y artículos oficiales). La llena scripts/indexar-conocimiento.ts en cada despliegue; se busca con la
/// búsqueda de texto en español de Postgres (configuración es_sin_tildes, ver la migración).
model Conocimiento {
  id            String   @id @default(cuid())
  clave         String   @unique // estable: "req:POL-01-R1", "manual:comites:2", "norma:DEC-1072-2015", "art:DEC-1072-2015:2.2.4.6.15"
  fuente        String // norma | articulo | requisito | estandar | manual | campo | plazo | decision | plantilla
  titulo        String
  texto         String
  normaCodigo   String?  @map("norma_codigo")
  articulo      String?
  href          String? // ruta interna; "{empresa}" donde va el id de la empresa
  urlOficial    String?  @map("url_oficial")
  literal       Boolean  @default(false) // true solo si `texto` es texto oficial copiado de la fuente
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([fuente])
  @@map("conocimiento")
}
